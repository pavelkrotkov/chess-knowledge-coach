[Unit]
Description=Bounded chess coach processing worker
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@ROOT@/.runtime
EnvironmentFile=@ROOT@/.runtime/config.env
Environment=CHESS_PROJECT_ROOT=@ROOT@
Environment=TMPDIR=@ROOT@/.runtime/tmp
Environment=XDG_CACHE_HOME=@ROOT@/.runtime/cache
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=PYTHONPATH PYTHONHOME
UMask=0077
ExecStart=@RELEASE@/venv/bin/python -I -m chess_coach.ops_worker
TimeoutStartSec=30min
Restart=no
StandardOutput=append:@ROOT@/.runtime/logs/worker.log
StandardError=append:@ROOT@/.runtime/logs/worker.log
NoNewPrivileges=true
