[Unit]
Description=Bounded chess coach cooldown retry
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@ROOT@/.runtime
EnvironmentFile=@ROOT@/.runtime/config.env
Environment=CHESS_PROJECT_ROOT=@ROOT@
Environment=TMPDIR=@ROOT@/.runtime/tmp
Environment=XDG_CACHE_HOME=@ROOT@/.runtime/cache
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=PYTHONPATH PYTHONHOME
UMask=0077
ExecStart=@RELEASE@/venv/bin/python -I -B -m chess_coach.ops_retry
TimeoutStartSec=30min
Restart=no
StandardOutput=append:@ROOT@/.runtime/logs/retry.log
StandardError=append:@ROOT@/.runtime/logs/retry.log
NoNewPrivileges=true
